  "cli": { "version": ">= 27.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "distribution": "internal", "environment": "development", "channel": "development", "env": { "APP_ENV": "development" }, "credentialsSource": "local", "android": { "buildType": "apk" } },
