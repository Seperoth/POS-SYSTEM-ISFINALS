{
  "name": "pos-system-isfinals",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start-preview.mjs",
    "dev": "node scripts/expo.mjs development start --web --port 5180",
    "native": "node scripts/expo.mjs development start --dev-client",
    "android": "node scripts/expo.mjs development run:android",
    "build": "node scripts/expo.mjs development export --platform web",
    "build:android": "node scripts/build-android.mjs production",
    "build:cloud": "eas build --platform android --profile production",
    "update:android": "node scripts/publish-update.mjs",
    "test": "node --test tests/*.test.js",
    "dev:prod": "node scripts/expo.mjs production start --web --port 5181",
    "build:prod": "node scripts/expo.mjs production export --platform web",
    "build:android:dev": "node scripts/build-android.mjs development",
    "build:cloud:dev": "eas build --platform android --profile development",
    "update:dev": "node scripts/publish-update.mjs development",
    "update:prod": "node scripts/publish-update.mjs production",
    "version:bump": "node scripts/version.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~58.0.16",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-network": "~58.0.4",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "lucide-react-native": "^1.67.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "eas-cli": "^27.3.0"
  }
}
